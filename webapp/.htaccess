<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^api(?:/|$) - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/(assets|images)(/|$)
  RewriteCond %{REQUEST_URI} !\.[^/]+$
  RewriteRule ^ /index.html [L]
</IfModule>
